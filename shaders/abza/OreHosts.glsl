        case 8300: return vec3(0.129, 0.698, 0.416);
        case 8301: return vec3(0.259, 0.349, 0.329);
        case 8302: return vec3(0.259, 0.239, 0.263);
        case 8303: return vec3(0.298, 0.137, 0.153);
