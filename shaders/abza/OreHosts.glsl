        case 8305: return vec3(0.318, 0.239, 0.263);
        case 8306: return vec3(0.318, 0.371, 0.392);
        case 8307: return vec3(0.318, 0.392, 0.318);
        case 8308: return vec3(0.349, 0.102, 0.153);
        case 8309: return vec3(0.380, 0.180, 0.165);
        case 8310: return vec3(0.376, 0.224, 0.282);
        case 8311: return vec3(0.392, 0.304, 0.284);
        case 8312: return vec3(0.392, 0.392, 0.325);
        case 8313: return vec3(0.392, 0.392, 0.392);
        case 8314: return vec3(0.441, 0.194, 0.176);
        case 8315: return vec3(0.491, 0.495, 0.490);
        case 8316: return vec3(0.498, 0.392, 0.380);
