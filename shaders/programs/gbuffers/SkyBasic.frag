//
//  Gbuffer for stars and ignored sky overlay (skybasic)
//

layout(location = 0) out vec4 gbufferData0;
layout(location = 1) out vec4 starData;

in vec3 color;
in float starVertex;
flat in vec3 starColor;

#include "/settings/GlobalSettings.glsl"
#include "/libs/Uniform.glsl"
#include "/abza/Stars.glsl"

void main() {
    float star = abzaStarFragment(starVertex);
    vec3 skyColor = star > 0.5 ? abzaStarColor(starColor) : color;
    if (dot(skyColor, vec3(1.0)) < 1e-6) {
        discard;
    }
    gbufferData0 = vec4(skyColor, 1.0);
    starData = abzaStarData(skyColor, star);
}

