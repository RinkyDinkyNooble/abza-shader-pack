# Sundial Language File : English (US)

screen.Texture=Texture
screen.Texture.comment=Texture filtering, plant and water movement, surface detail and material settings
screen.PlantWave=Plant wave
screen.PlantWave.comment=How grass, leaves and other plants sway in the wind
screen.Water=Water
screen.Water.comment=Look and movement of water waves
screen.Normal=Normal
screen.Normal.comment=Surface bumps from resource pack normal maps
screen.DirectionalLightLevel=Directional light level
screen.DirectionalLightLevel.comment=Lets block light and sky light follow the bumps of normal maps
screen.Parallax=Parallax
screen.Parallax.comment=Fake depth on block surfaces from resource pack height maps
screen.Specular=PBR
screen.Specular.comment=Shine, metal and glow of materials, from the resource pack and the shader's own list of blocks
screen.Reflection=Reflection
screen.Reflection.comment=Reflections on water, glass and shiny blocks
screen.Shadow=Shadow
screen.Shadow.comment=Shadows from the sun and the moon. The shadow distance and the entity shadow switches cost the most
screen.Lighting=Lighting
screen.Lighting.comment=Sunlight, moonlight and block light brightness and colour, and ray-traced bounce light
screen.VisibilityBitmask=Ray tracing
screen.VisibilityBitmask.comment=Screen-space ray tracing for bounce light (light bouncing off blocks) and ambient occlusion (darkening in corners). Rays are traced across the picture on screen, so they only find what you can see. Each can be turned off; with both off, no rays are traced
screen.Atmosphere=Atmosphere
screen.Atmosphere.comment=Sky, distance haze, fog, light shafts and the planets' own fog
screen.RainFog=Rain fog
screen.RainFog.comment=Haze and blur in rain
screen.WaterFog=Water fog
screen.WaterFog.comment=Colour and clearness of water when looking through it
screen.VolumetricLight=Volumetric light
screen.VolumetricLight.comment=Light shafts through the air when the sun or moon shines past blocks
screen.VolumetricFog=Volumetric fog
screen.VolumetricFog.comment=Patchy ground fog drawn together with volumetric light. It uses the same samples and turns off when volumetric light is off
screen.CommonFog=Common fog
screen.CommonFog.comment=Fog in powder snow, lava, the Nether and the End
screen.Cloud=Cloud
screen.Cloud.comment=The shader's clouds. Only Earth and Eden have clouds
screen.BlockyCloud=Blocky cloud
screen.BlockyCloud.comment=Settings for the blocky cloud type
screen.PlaneCloud=Plane cloud
screen.PlaneCloud.comment=A thin, high cloud layer above the main clouds
screen.RealisticCloudQuality=Realistic cloud quality
screen.RealisticCloudQuality.comment=Sample counts for realistic clouds. Lower is faster
screen.RealisticCloudShape=Realistic cloud shape
screen.RealisticCloudShape.comment=Amount, height and shape of realistic clouds
screen.RealisticCloudLighting=Realistic cloud lighting
screen.RealisticCloudLighting.comment=How light passes through realistic clouds
screen.PostProcessing=Post processing
screen.PostProcessing.comment=Effects applied to the finished picture: bloom, exposure, colour, blur and sharpening
screen.MotionBlur=Motion blur
screen.MotionBlur.comment=Blur when the camera moves
screen.ToneMapping=Tone mapping
screen.ToneMapping.comment=How the shader's bright, wide range of light is fitted to your screen, and the final colour grade
screen.Uchimura=Uchimura settings
screen.Uchimura.comment=Settings for the Uchimura tonemap
screen.AgX=AgX settings
screen.AgX.comment=Settings for the AgX tonemap
screen.GT7=GT7 settings
screen.GT7.comment=Settings for the GT7 tonemap
screen.Exposure=Exposure
screen.Exposure.comment=Overall brightness, and how it adapts to bright and dark places like an eye
screen.DepthOfField=Depth of field
screen.DepthOfField.comment=Blur on things nearer or farther than where you look, like a camera lens
screen.ChromaticDispersion=Chromatic dispersion
screen.ChromaticDispersion.comment=Colour fringes toward the screen edges, like a cheap lens
screen.Sharpening=Sharpening
screen.Sharpening.comment=Sharpens the final picture
screen.TAA=Temporal anti aliasing
screen.TAA.comment=Smooths jagged edges and noise by blending each frame with the frames before it
screen.Weather=Weather
screen.Weather.comment=Puddles, ripples and raindrops
screen.ModSupport=Mod support
screen.ModSupport.comment=Guesses for modded blocks and effects the shader doesn't know
screen.Experimental=Experimental effect
screen.Experimental.comment=Effects that can look wrong in some places

# Texture
option.ANISOTROPIC_FILTERING_QUALITY=Anisotropic filter
option.ANISOTROPIC_FILTERING_QUALITY.comment=Keeps ground textures sharp at shallow angles. The number is the texture samples per pixel; Stochastic takes 1 random sample each frame. Higher is slower. Use this instead of the setting in your graphics driver, which causes problems
value.ANISOTROPIC_FILTERING_QUALITY.0=off
value.ANISOTROPIC_FILTERING_QUALITY.1=Stochastic
value.ANISOTROPIC_FILTERING_QUALITY.2=2x
value.ANISOTROPIC_FILTERING_QUALITY.4=4x
value.ANISOTROPIC_FILTERING_QUALITY.8=8x
value.ANISOTROPIC_FILTERING_QUALITY.16=16x
value.ANISOTROPIC_FILTERING_QUALITY.32=32x
option.REFRACTION_STRENGTH=Refraction strength
option.REFRACTION_STRENGTH.comment=How much water and glass bend what's behind them, as a multiplier. 0 turns bending off
option.REFRACTION_EDGE_FADE=Refraction edge fade
option.REFRACTION_EDGE_FADE.comment=Weakens refraction near the screen edges, where the bent view would leave the screen, as a share of the screen (0 to 1). Higher hides hard edges better
# PlantWave
option.PLANT_WAVE=Plant wave
option.PLANT_WAVE.comment=Grass, leaves, crops and other plants sway in the wind
option.PLANT_WAVE_STRENGTH=Wave strength
option.PLANT_WAVE_STRENGTH.comment=How far plants sway, as a multiplier
option.PLANT_WAVE_SPEED=Wave speed
option.PLANT_WAVE_SPEED.comment=How fast plants sway, as a multiplier
option.PLANT_WAVE_RAIN_EXTRA_STRENGTH=Rain extra wave strength
option.PLANT_WAVE_RAIN_EXTRA_STRENGTH.comment=Extra sway in rain, added to the wave strength
# Water
option.WATER_TYPE=Water type
option.WATER_TYPE.comment=Default draws clear water with the shader's waves. Vanilla keeps the game's water texture and colour
value.WATER_TYPE.0=Default
value.WATER_TYPE.1=Vanilla
option.CAULDRON_WAVE=Cauldron water wave
option.CAULDRON_WAVE.comment=Draws waves on water in cauldrons too. Needs the default water type
option.WATER_WAVE_SCALE=Water wave scale
option.WATER_WAVE_SCALE.comment=Size of the waves, as a multiplier
option.WATER_WAVE_HEIGHT=Water wave height
option.WATER_WAVE_HEIGHT.comment=Height of the waves, as a multiplier
option.WATER_WAVE_SPEED=Water wave speed
option.WATER_WAVE_SPEED.comment=How fast the waves move, as a multiplier
option.WATER_WAVE_STEEPNESS=Water wave steepness
option.WATER_WAVE_STEEPNESS.comment=How sharp the wave crests are, from 0 (round) to 1 (pointed)
option.WATER_WAVE_LAYERS_SCALE=Water wave octave scale
option.WATER_WAVE_LAYERS_SCALE.comment=Waves are built from layers of smaller and smaller waves. This is how much shorter each layer is than the one before
option.WATER_WAVE_LAYERS_FADE=Water wave octave fade
option.WATER_WAVE_LAYERS_FADE.comment=Height of each wave layer compared to the one before, from 0 to 1
option.WATER_WAVE_HEIGHT_LAYERS=Water wave height layers
option.WATER_WAVE_HEIGHT_LAYERS.comment=Number of wave layers used for the water's surface depth. High values are slow and rarely needed
option.WATER_WAVE_NORMAL_LAYERS=Water wave normal layers
option.WATER_WAVE_NORMAL_LAYERS.comment=Number of wave layers used for the water's surface shading. More shows finer ripples and is slower
# Normal
option.NORMAL_FORMAT=Normal format
option.NORMAL_FORMAT.comment=Format of the resource pack's normal maps. LabPBR rebuilds the depth axis from the other two; ClassicPBR uses all three as stored
option.NORMAL_STRENGTH=Normal strength
option.NORMAL_STRENGTH.comment=How strong the surface bumps from normal maps look, as a multiplier. 0 flattens them
option.PARALLAX_BASED_NORMAL=Parallax based normal
option.PARALLAX_BASED_NORMAL.comment=Takes surface bumps from the parallax height map instead of the normal map where a block has depth. Overrides smooth normal
option.SMOOTH_NORMAL=Smooth normal
option.SMOOTH_NORMAL.comment=Smooths normal map pixels. Parallax based normal overrides it
option.ENTITY_VERTEX_TBN=Entity vertex TBN
option.ENTITY_VERTEX_TBN.comment=Uses the model's own surface directions on mobs and other entities. Less precise, but smoother on some modded entities; a few entities have wrong data and look odd
# DirectionalLightLevel
option.DIRECTIONAL_LIGHT_LEVEL=Directional light level
option.DIRECTIONAL_LIGHT_LEVEL.comment=Lets block light and sky light shade the bumps of normal maps. Can look odd in some scenes
option.DIRECTIONAL_BLOCK_LIGHT_STRENGTH=Directional block light strength
option.DIRECTIONAL_BLOCK_LIGHT_STRENGTH.comment=How strongly block light shades surface bumps, as a multiplier
option.DIRECTIONAL_SKY_LIGHT_STRENGTH=Directional sky light strength
option.DIRECTIONAL_SKY_LIGHT_STRENGTH.comment=How strongly sky light shades surface bumps, as a multiplier
# Parallax
option.PARALLAX=Parallax
option.PARALLAX.comment=Gives block surfaces real-looking depth from the resource pack's height maps. Needs a pack with height maps. Costly
option.SMOOTH_PARALLAX=Smooth parallax
option.SMOOTH_PARALLAX.comment=Smooths the parallax depth between pixels. Voxel parallax overrides it
option.VOXEL_PARALLAX=Voxel parallax
option.VOXEL_PARALLAX.comment=Steps through the depth pixel by pixel for exact, blocky depth. Overrides smooth parallax; suits low-resolution packs
option.ENTITY_PARALLAX=Entity parallax
option.ENTITY_PARALLAX.comment=Parallax depth on mobs and other entities too
option.ENTITY_TEXTURE_RESOLUTION=Entity texture resolution
option.ENTITY_TEXTURE_RESOLUTION.comment=Texture size of your resource pack, in pixels per side (16 for vanilla). Used by entity parallax; it can't be detected automatically
option.PARALLAX_DEPTH=Parallax depth
option.PARALLAX_DEPTH.comment=How deep parallax surfaces look, as a multiplier
option.PARALLAX_QUALITY=Parallax quality
option.PARALLAX_QUALITY.comment=Steps per pixel through the depth. Higher shows cleaner edges where depth changes, at a large cost
option.PARALLAX_MAX_REFINEMENTS=Parallax fineness
option.PARALLAX_MAX_REFINEMENTS.comment=Extra steps that refine the depth once a surface is found. Cheaper than quality, but doesn't clean up edges where depth changes
option.SMOOTH_PARALLAX_OFFSET=Smooth parallax offset
option.SMOOTH_PARALLAX_OFFSET.comment=Shifts the parallax depth by half a pixel so it lines up with smooth parallax. Also applies to parallax based normal
value.SMOOTH_PARALLAX_OFFSET.0=Off
value.SMOOTH_PARALLAX_OFFSET.1=Left lower
value.SMOOTH_PARALLAX_OFFSET.2=Left upper
value.SMOOTH_PARALLAX_OFFSET.3=Right lower
value.SMOOTH_PARALLAX_OFFSET.4=Right upper
# Specular
option.SUBSERFACE_SCATTERING_STRENTGH=Sub-surface scattering strength
option.SUBSERFACE_SCATTERING_STRENTGH.comment=How much light shines through leaves, grass and other thin materials, as a multiplier. 0 turns it off
option.PBR_BRIGHTNESS=PBR brightness
option.PBR_BRIGHTNESS.comment=Brightness of glowing blocks, from the resource pack and the shader's own list, as a multiplier
option.SPECULAR_FORMAT=PBR format
option.SPECULAR_FORMAT.comment=Format of the resource pack's material maps (shine, metal and glow). LabPBR is the most common
option.SPECULAR_EMISSIVE=PBR emissive
option.SPECULAR_EMISSIVE.comment=Glow from the resource pack's material maps. Doesn't affect the shader's own glowing blocks
option.HARDCODED_EMISSIVE=Hardcoded emissive
option.HARDCODED_EMISSIVE.comment=The shader's own list of glowing blocks (torches, lava, lamps and so on). Can be turned off with a resource pack that has its own glow
option.LABPBR_F0=LabPBR F0
option.LABPBR_F0.comment=Reads how reflective a surface is from LabPBR material maps, instead of only metal or not metal
option.HARDCODED_METAL=LabPBR hardcoded metal
option.HARDCODED_METAL.comment=Reads LabPBR's named metals (iron, gold and so on) for their real colours. Needs a resource pack that uses them
option.LABPBR_POROSITY=LabPBR porosity
option.LABPBR_POROSITY.comment=Reads porosity from LabPBR material maps, mainly for light shining through thin materials
option.LABPBR_TEXTURE_AO=LabPBR texture AO
option.LABPBR_TEXTURE_AO.comment=Darkens pixels by the ambient occlusion stored in LabPBR material maps. Turn on only if your resource pack has it

# Reflection
option.REFLECTION=Reflection
option.REFLECTION.comment=Reflections on water, glass and shiny blocks. Costly
option.FULL_REFLECTION=Full reflection
option.FULL_REFLECTION.comment=Reflects on every surface that isn't fully rough, not just shiny ones. Slower with PBR resource packs
option.REFLECTION_FILTER=Reflection filter
option.REFLECTION_FILTER.comment=Smooths rough reflections by blending nearby pixels: Low blends 3x3 pixels, High 5x5
value.REFLECTION_FILTER.0=off
value.REFLECTION_FILTER.1=Low
value.REFLECTION_FILTER.2=High
option.CLOUD_IN_REFLECTION=Cloud in reflection
option.CLOUD_IN_REFLECTION.comment=Shows clouds in reflections of the sky. Costly over large water
option.SCREEN_SPACE_REFLECTION_STEP=Screen space reflection steps
option.SCREEN_SPACE_REFLECTION_STEP.comment=Steps per reflected ray when looking for what it hits. More finds thin objects and far terrain more reliably, at a cost
option.SCREEN_SPACE_REFLECTION_REFINEMENTS=Screen space reflection refinements
option.SCREEN_SPACE_REFLECTION_REFINEMENTS.comment=Extra steps that pin down the exact hit point. More gives sharper reflected edges

# Shadow
option.shadowMapResolution=Shadowmap resolution
option.shadowMapResolution.comment=Size of the shadow map, in pixels per side. Lower is faster and gives softer, blockier shadows
option.shadowDistance=Shadow distance
option.shadowDistance.comment=How far shadows reach from you, in blocks. Lower is faster and makes close shadows sharper
option.SHADOW_DISTORTION_STRENGTH=Shadow distortion strength
option.SHADOW_DISTORTION_STRENGTH.comment=How much of the shadow map goes to shadows near you. Higher sharpens close shadows; lower sharpens far ones
option.sunPathRotation=Sun path rotation
option.PCSS_SAMPLES=PCSS samples
option.PCSS_SAMPLES.comment=Shadow map samples per pixel for soft shadows. Higher gives smoother shadow edges, at a cost
option.SCREEN_SPACE_SHADOW_SAMPLES=Screen space shadow samples
option.SCREEN_SPACE_SHADOW_SAMPLES.comment=Samples per pixel for the fine contact shadows of small details. Higher is more accurate and slower
option.PCSS=Percentage closer soft shadow
option.PCSS.comment=Shadows get softer the farther they fall from what casts them, like real shadows. Off gives a single hard shadow sample, which is faster
option.SCREEN_SPACE_SHADOW=Screen space shadow
option.SCREEN_SPACE_SHADOW.comment=Adds fine contact shadows for small details the shadow map misses
option.TRANSPARENT_SHADOW=Transparent shadow
option.TRANSPARENT_SHADOW.comment=Stained glass and other see-through blocks cast coloured shadows
option.WATER_CAUSTIC=Underwater caustic
option.WATER_CAUSTIC.comment=Rippling light patterns under water in sunlight
option.CLOUD_SHADOW=Cloud shadow
option.CLOUD_SHADOW.comment=Clouds cast moving shadows on the ground
option.LIGHT_LEAKING_FIX=Light leaking fix
option.LIGHT_LEAKING_FIX.comment=Keeps sunlight out of caves where the shadow map doesn't reach. Can dim caustics under water and the inside of large overhangs

# Lighting
option.MOD_LIGHT_DETECTION=Mod light detection
option.MOD_LIGHT_DETECTION.comment=Treats every block face at full block light as a light source, for modded lamps the shader doesn't know. Some faces may glow that shouldn't
option.VANILLA_BLOCK_LIGHT_FADE=Vanilla block light fade
option.VANILLA_BLOCK_LIGHT_FADE.comment=How quickly light from torches and lamps fades with distance. Higher keeps it closer to the light
option.SUNLIGHT_BRIGHTNESS=Sun light brightness
option.SUNLIGHT_BRIGHTNESS.comment=Brightness of sunlight and moonlight, as a multiplier
option.NIGHT_BRIGHTNESS=Night brightness
option.NIGHT_BRIGHTNESS.comment=Moonlight as a share of sunlight (0.001 is a thousandth). The planets scale it with their own night light
option.NIGHT_VISION_BRIGHTNESS=Night vision brightness
option.NIGHT_VISION_BRIGHTNESS.comment=Light added by night vision, as a share of daylight
# LightColor
option.LIGHT_BRIGHTNESS=Light brightness
option.LIGHT_BRIGHTNESS.comment=Brightness of block light (torches, lamps and so on), as a multiplier
option.LIGHT_COLOR_R=Light color: red
option.LIGHT_COLOR_R.comment=Red part of the block light colour
option.LIGHT_COLOR_G=Light color: green
option.LIGHT_COLOR_G.comment=Green part of the block light colour
option.LIGHT_COLOR_B=Light color: blue
option.LIGHT_COLOR_B.comment=Blue part of the block light colour
option.ambientOcclusionLevel=Block corner shading
option.ambientOcclusionLevel.comment=Soft shading where blocks meet, like vanilla smooth lighting, from 0 (off) to 1 (vanilla strength). Needs Smooth Lighting on in the video settings. Adds to crease shading
option.CREASE_SHADING_STRENGTH=Crease shading
option.CREASE_SHADING_STRENGTH.comment=Darkens the light where surfaces meet: wall and floor, under ledges, around tall grass. Darkens sunlight, sky light, lamp light and bounced light; glowing blocks keep their glow. 0 turns it off; higher is darker. Needs ambient occlusion on (Ray tracing)
option.CREASE_SHADING_RADIUS=Crease shading radius
option.CREASE_SHADING_RADIUS.comment=How far the shading reaches out from a crease, in blocks. Larger gives softer, wider shading
option.CREASE_SHADING_DIRECT=Crease shading in direct light
option.CREASE_SHADING_DIRECT.comment=How much crease shading darkens direct sunlight and moonlight, from 0 (only shade, lamp light and bounced light) to 1 (as much as the shade)
option.SUN_SHEEN=Sun sheen
option.SUN_SHEEN.comment=A soft highlight where sunlight or moonlight lands on blocks without their own material maps (grass, dirt, stone), strongest when you look toward the sun. Smooth, wet and metal surfaces keep their own shine. 0 turns it off
option.SUN_SHEEN_FOCUS=Sun sheen focus
option.SUN_SHEEN_FOCUS.comment=How gathered the sun sheen is. Low spreads a faint sheen over a wide area; high makes a smaller, brighter highlight
option.PLANT_GLOW=Plant glow
option.PLANT_GLOW.comment=How much brighter grass, flowers and leaves glow when you look toward the sun through them. 0 keeps light through plants the same from every side
option.SHADE_FILL=Shade fill
option.SHADE_FILL.comment=How much sunlight and moonlight brighten shaded ground outdoors, as if bounced from lit surfaces, as a multiplier. Lower gives darker shade and more contrast with sunlit ground. Caves and the sky's own blue light aren't affected
option.SHADOW_EDGE_SOFTNESS=Shadow edge softness
option.SHADOW_EDGE_SOFTNESS.comment=Smallest blur on soft shadow edges, as a multiplier. Lower gives crisper small shadows such as grass tufts and flowers, at no cost; shadows still soften with distance from what casts them. Too low can show the shadow map's square texels
# VisibilityBitmask
option.VBGI=Ray-traced bounce light
option.AMBIENT_OCCLUSION=Ambient occlusion
option.AMBIENT_OCCLUSION.comment=Ray-traced shade where surfaces close in: corners, caves, rooms and under ledges get less sky light and lamp light, and crease shading darkens where surfaces meet. Off brightens caves and interiors a lot; with bounce light also off, it saves all the ray tracing
option.VBGI.comment=Global illumination: light bounces off blocks onto nearby surfaces, ray traced in screen space. Costly; off stops its rays, so only ambient occlusion is traced, with one ray per pixel
option.VB_TRACE_COUNT=Bounce light rays
option.VB_TRACE_COUNT.comment=Rays per pixel for ray-traced bounce light; no effect when it's off. More is smoother, with less shimmer from small bright lights such as glowing ores, and slower: the cost grows with the count, and 4 rays halve the shimmer
option.VB_STEPS=Ray steps
option.VB_STEPS.comment=Steps along each ray, for bounce light and ambient occlusion. More finds more detail and is slower
option.VB_GI_LENGTH=Bounce light ray length
option.VB_GI_LENGTH.comment=How far rays reach when bounce light is on; ambient occlusion uses it then too. A relative value, not blocks
option.VB_AO_LENGTH=Ambient occlusion ray length
option.VB_AO_LENGTH.comment=How far ambient occlusion rays reach when bounce light is off. A relative value, not blocks
option.VB_MAX_BLEDED_FRAMES=Ray tracing frames blended
option.VB_MAX_BLEDED_FRAMES.comment=Most frames blended together to smooth bounce light and ambient occlusion. Higher is smoother but reacts slower to changes in light

# Atmosphere
option.ATMOSPHERE_VIEW_SAMPLE=Atmosphere view samples
option.ATMOSPHERE_VIEW_SAMPLE.comment=Samples per sky pixel for the sky's colour on Earth and Eden. Higher is more accurate and slower
option.WORLD_BASIC_HEIGHT=World basic height
option.WORLD_BASIC_HEIGHT.comment=Altitude of Y 0 above the bottom of the atmosphere, in blocks. Higher thins the air and its haze around you
option.VOLUMETRIC_LIGHT=Volumetric light
option.VOLUMETRIC_LIGHT.comment=Light shafts through the air on Earth and Eden. Turns volumetric fog off with it. Costly
option.VOLUMETRIC_FOG=Volumetric fog
option.VOLUMETRIC_FOG.comment=Patchy fog near the ground on Earth and Eden, thickest in the morning and in wet biomes. Needs volumetric light
option.ATMOSPHERE_SCATTERING_FOG=Atmosphere scattering fog
option.ATMOSPHERE_SCATTERING_FOG.comment=Distant land fades into the colour of the air on Earth and Eden
option.PLANET_FOG=Planet fog
option.PLANET_FOG.comment=Each planet's own fog in its biomes' colours: spore haze on Interloper, ash haze on Cinder, dark fog on Umbra, mist on Eden. Cheap
option.PLANET_FOG_DENSITY=Planet fog density
option.PLANET_FOG_DENSITY.comment=Thickness of the planet fog, as a multiplier
option.PLANET_FOG_BRIGHTNESS=Planet fog brightness
option.PLANET_FOG_BRIGHTNESS.comment=Brightness of the planet fog, as a multiplier
option.PLANET_FOG_HEIGHT=Planet fog height
option.PLANET_FOG_HEIGHT.comment=How far the planet fog reaches above the ground, as a multiplier. Higher fills more of the sky with haze and fogs hilltops more; lower keeps the haze near the horizon
# CommonFog
option.SNOW_FOG_DENSITY=Powder snow fog density
option.SNOW_FOG_DENSITY.comment=Thickness of the fog inside powder snow, as a multiplier
option.LAVA_FOG_DENSITY=Lava fog density
option.LAVA_FOG_DENSITY.comment=Thickness of the fog inside lava, as a multiplier
option.LAVA_FOG_BRIGHTNESS=Lava fog brightness
option.LAVA_FOG_BRIGHTNESS.comment=Brightness of the fog inside lava, as a multiplier
option.NETHER_FOG_DENSITY=Nether fog density
option.NETHER_FOG_DENSITY.comment=Thickness of the Nether's fog, as a multiplier
option.NETHER_FOG_BRIGHTNESS=Nether fog brightness
option.NETHER_FOG_BRIGHTNESS.comment=Brightness of the Nether's fog, as a multiplier
option.END_FOG_DENSITY=The end fog density
option.END_FOG_DENSITY.comment=Thickness of the End's fog, as a multiplier
option.END_FOG_BRIGHTNESS=The end fog brightness
option.END_FOG_BRIGHTNESS.comment=Brightness of the End's fog, as a multiplier
option.END_GALAXY_AMOUNT=The end galaxy amount
option.END_GALAXY_AMOUNT.comment=How much of the End's sky the galaxy covers, from 0 to 1
option.END_GALAXY_BRIGHTNESS=The end galaxy brightness
option.END_GALAXY_BRIGHTNESS.comment=Brightness of the galaxy in the End's sky, as a multiplier
# RainFog
option.RF_DENSITY=Rain fog density
option.RF_DENSITY.comment=Thickness of the haze in rain, over both sky and land, as a multiplier
option.RF_GROUND_EXTRA_DENSITY=Rain fog ground extra density
option.RF_GROUND_EXTRA_DENSITY.comment=Extra rain haze over land only, as a multiplier
option.RAIN_BLOOM_FOG_DENSITY=Rain bloom fog density
option.RAIN_BLOOM_FOG_DENSITY.comment=Blurs distant things in rain, as a multiplier. Only outdoors
# WaterFog
option.WATER_ABSORPTION_R=Water fog absorption: red
option.WATER_ABSORPTION_R.comment=Share of red light water absorbs per block. Higher makes water less red with depth
option.WATER_ABSORPTION_G=Water fog absorption: green
option.WATER_ABSORPTION_G.comment=Share of green light water absorbs per block
option.WATER_ABSORPTION_B=Water fog absorption: blue
option.WATER_ABSORPTION_B.comment=Share of blue light water absorbs per block
option.WATER_SCATTERING_R=Water fog scattering: red
option.WATER_SCATTERING_R.comment=How much red light water scatters back, from 0 to 1. Sets the water's own colour
option.WATER_SCATTERING_G=Water fog scattering: green
option.WATER_SCATTERING_G.comment=How much green light water scatters back, from 0 to 1
option.WATER_SCATTERING_B=Water fog scattering: blue
option.WATER_SCATTERING_B.comment=How much blue light water scatters back, from 0 to 1
# VolumetricLight
option.VL_STRENGTH=Volumetric light strength
option.VL_STRENGTH.comment=Brightness of light shafts, as a multiplier
option.VL_SAMPLES=Volumetric light samples
option.VL_SAMPLES.comment=Samples per pixel along the view for light shafts and volumetric fog. Lower is faster and noisier
option.VL_HALF_RES=Half-resolution light shafts
option.VL_HALF_RES.comment=Computes light shafts and volumetric fog at half the screen resolution, a quarter of the pixels, smooths them over the last few frames and blends them in at full resolution. Pixels at the edges of nearer objects are computed at full resolution, so trees and hills get no halos
option.MORNING_VL_STRENGTH=Volumetric light morning strength
option.MORNING_VL_STRENGTH.comment=Light shaft strength at sunrise and sunset, as a multiplier
option.NOON_VL_STRENGTH=Volumetric light noon strength
option.NOON_VL_STRENGTH.comment=Light shaft strength at noon, as a multiplier
# VolumetricFog
option.VOLUMETRIC_FOG_AMOUNT=Volumetric fog amount
option.VOLUMETRIC_FOG_AMOUNT.comment=How much of the fog layer is filled with fog. Higher leaves fewer gaps
option.VOLUMETRIC_FOG_DENSITY=Volumetric fog density
option.VOLUMETRIC_FOG_DENSITY.comment=Thickness of the volumetric fog, as a multiplier
option.VOLUMETRIC_FOG_CENTER_HEIGHT=Volumetric fog center height
option.VOLUMETRIC_FOG_CENTER_HEIGHT.comment=Height of the middle of the fog layer, as a Y level
option.VOLUMETRIC_FOG_THICKNESS=Volumetric fog thickness
option.VOLUMETRIC_FOG_THICKNESS.comment=Height of the fog layer, in blocks
option.VOLUMETRIC_FOG_MORNING_DENSITY=Volumetric fog morning strength
option.VOLUMETRIC_FOG_MORNING_DENSITY.comment=Fog thickness at sunrise and sunset, as a multiplier
option.VOLUMETRIC_FOG_NOON_DENSITY=Volumetric fog noon strength
option.VOLUMETRIC_FOG_NOON_DENSITY.comment=Fog thickness at noon, as a multiplier
